{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NodeFable",
  "version": "0.1.0",
  "identifier": "com.nodefable.app",
  "build": {
    "frontendDist": "../frontend/editor"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NodeFable",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/192x192.png", "icons/icon.png"]
  }
}
